{
  "name": "hivesigner-ui-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React (Rsbuild) rewrite of the Hivesigner UI. Long-lived rewrite target; coexists with the Nuxt app until cutover (see README).",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "rsbuild dev --open",
    "build": "rsbuild build && node scripts/check-node-globals.mjs",
    "preview": "rsbuild preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write",
    "lint:ci": "biome ci",
    "format": "biome format --write",
    "check:node-globals": "node scripts/check-node-globals.mjs"
  },
  "dependencies": {
    "@ecency/sdk": "^2.4.10",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@sentry/browser": "^10.74.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.132.27",
    "clsx": "^2.1.1",
    "i18next": "^24.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.3",
    "@rsbuild/core": "^1.5.6",
    "@rsbuild/plugin-react": "^1.4.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@tanstack/router-plugin": "^1.132.27",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
